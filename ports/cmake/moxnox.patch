@@ -1760,6 +1767,67 @@ static int kwsysProcessCreate(kwsysProcess* cp, int prIndex,
      parent!  TODO: OptionDetach.  Also
      TODO:  CreateProcessGroup.  */
   cp->ForkPIDs[prIndex] = vfork();
+#elif defined(__moxnox__)
+  /* There is no fork; create the child with posix_spawn, expressing the
+     child-side setup below as spawn attributes and file actions.  The
+     error and pgid pipe write ends are close-on-exec, so the parent's
+     handshake reads below get EOF once the child is running, and spawn
+     failure is reported synchronously here rather than via the pipe.  */
+  {
+    extern char** environ;
+    posix_spawn_file_actions_t fa;
+    posix_spawnattr_t attr;
+    sigset_t sigdefault;
+    short flags = POSIX_SPAWN_SETSIGDEF | POSIX_SPAWN_SETSIGMASK;
+    pid_t pid;
+    int err;
+
+    posix_spawn_file_actions_init(&fa);
+    posix_spawnattr_init(&attr);
+
+    /* The child does not need the pipe read ends.  */
+    posix_spawn_file_actions_addclose(&fa, si->ErrorPipe[0]);
+    posix_spawn_file_actions_addclose(&fa, pgidPipe[0]);
+
+    /* Setup the stdin, stdout, and stderr pipes.  */
+    if (si->StdIn > 0) {
+      posix_spawn_file_actions_adddup2(&fa, si->StdIn, 0);
+    } else if (si->StdIn < 0) {
+      posix_spawn_file_actions_addclose(&fa, 0);
+    }
+    if (si->StdOut != 1) {
+      posix_spawn_file_actions_adddup2(&fa, si->StdOut, 1);
+    }
+    if (si->StdErr != 2) {
+      posix_spawn_file_actions_adddup2(&fa, si->StdErr, 2);
+    }
+
+    /* Restore all default signal handlers, and restore the pre-block
+       signal mask in the child.  */
+    sigfillset(&sigdefault);
+    posix_spawnattr_setsigdefault(&attr, &sigdefault);
+    posix_spawnattr_setsigmask(&attr, &old_mask);
+
+    /* setsid covers both the process-group creation of the fork flow and
+       detached children (no intermediate process is needed, as unwaited
+       processes are not zombies on Moxnox).  */
+    if (cp->CreateProcessGroup || cp->OptionDetach) {
+      flags |= POSIX_SPAWN_SETSID;
+    }
+    posix_spawnattr_setflags(&attr, flags);
+
+    err = posix_spawnp(&pid, cp->Commands[prIndex][0], &fa, &attr,
+                       cp->Commands[prIndex], environ);
+
+    posix_spawn_file_actions_destroy(&fa);
+    posix_spawnattr_destroy(&attr);
+
+    if (err != 0) {
+      errno = err;
+      pid = -1;
+    }
+    cp->ForkPIDs[prIndex] = pid;
+  }
 #else
   cp->ForkPIDs[prIndex] = kwsysProcessFork(cp, si);
 #endif
