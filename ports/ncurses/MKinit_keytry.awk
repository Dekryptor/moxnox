# MKinit_keytry.awk - generate init_keytry.h from Caps files
# Replaces the make_keys host-tool step from the ncurses autotools build.
# Usage: awk -f MKinit_keytry.awk Caps Caps-ncurses > init_keytry.h

/^#/ || /^capalias/ || /^infoalias/ || /^userdef/ || /^SKIPWARN/ || /^$/ { next }

$3 == "str" {
    strfname_idx[$1] = str_count;
    strname_idx[$2]  = str_count;
    str_count++;
}

$3 == "str" && $5 != "-" && substr($5, 1, 4) == "KEY_" {
    key_code[$5] = $1;
    key_order[key_count++] = $5;
}

END {
    print "#ifndef _INIT_KEYTRY_H"
    print "#define _INIT_KEYTRY_H 1"
    print ""
    print "/* This file was generated by MKinit_keytry.awk */"
    print ""
    print "#include <tic.h>"
    print ""
    print "#if BROKEN_LINKER"
    print "static"
    print "#endif"
    print "const struct tinfo_fkeys _nc_tinfo_fkeys[] = {"
    for (i = 0; i < key_count; i++) {
        key = key_order[i];
        lname = key_code[key];
        idx = strfname_idx[lname];
        printf "\t{ %4u, %-20s},\t/* %s */\n", idx, key ",", lname;
    }
    print "\t{ 0, 0} };"
    print ""
    print "#endif /* _INIT_KEYTRY_H */"
}
