 static inline void set_cloexec(int fd)
@@ -745,7 +750,93 @@ int start_command(struct child_process *cmd)
 	if (cmd->close_object_store)
 		odb_close(the_repository->objects);
 
-#ifndef GIT_WINDOWS_NATIVE
+#if defined(MOXNOX)
+{
+	posix_spawn_file_actions_t fa;
+	struct strvec argv = STRVEC_INIT;
+	char **childenv;
+
+	if (prepare_cmd(&argv, cmd) < 0) {
+		failed_errno = errno;
+		cmd->pid = -1;
+		if (!cmd->silent_exec_failure)
+			error_errno("cannot run %s", cmd->args.v[0]);
+	} else {
+		int err;
+
+		trace_argv_printf(&argv.v[1], "trace: start_command:");
+
+		childenv = prep_childenv(cmd->env.v);
+		posix_spawn_file_actions_init(&fa);
+
+		if (cmd->no_stdin)
+			posix_spawn_file_actions_addopen(&fa, 0, "/dev/null", O_RDWR, 0);
+		else if (need_in) {
+			posix_spawn_file_actions_adddup2(&fa, fdin[0], 0);
+			posix_spawn_file_actions_addclose(&fa, fdin[0]);
+			posix_spawn_file_actions_addclose(&fa, fdin[1]);
+		} else if (cmd->in) {
+			posix_spawn_file_actions_adddup2(&fa, cmd->in, 0);
+			posix_spawn_file_actions_addclose(&fa, cmd->in);
+		}
+
+		/* set up stderr before stdout, for cmd->stdout_to_stderr */
+		if (cmd->no_stderr)
+			posix_spawn_file_actions_addopen(&fa, 2, "/dev/null", O_RDWR, 0);
+		else if (need_err) {
+			posix_spawn_file_actions_adddup2(&fa, fderr[1], 2);
+			posix_spawn_file_actions_addclose(&fa, fderr[0]);
+			posix_spawn_file_actions_addclose(&fa, fderr[1]);
+		} else if (cmd->err > 1) {
+			posix_spawn_file_actions_adddup2(&fa, cmd->err, 2);
+			posix_spawn_file_actions_addclose(&fa, cmd->err);
+		}
+
+		if (cmd->no_stdout)
+			posix_spawn_file_actions_addopen(&fa, 1, "/dev/null", O_RDWR, 0);
+		else if (cmd->stdout_to_stderr)
+			posix_spawn_file_actions_adddup2(&fa, 2, 1);
+		else if (need_out) {
+			posix_spawn_file_actions_adddup2(&fa, fdout[1], 1);
+			posix_spawn_file_actions_addclose(&fa, fdout[0]);
+			posix_spawn_file_actions_addclose(&fa, fdout[1]);
+		} else if (cmd->out > 1) {
+			posix_spawn_file_actions_adddup2(&fa, cmd->out, 1);
+			posix_spawn_file_actions_addclose(&fa, cmd->out);
+		}
+
+		if (cmd->dir)
+			posix_spawn_file_actions_addchdir(&fa, cmd->dir);
+
+		/*
+		 * argv.v[1] is the program (prepare_cmd resolves it via the
+		 * PATH lookup); argv.v[0] is SHELL_PATH, used as the ENOEXEC
+		 * fallback, mirroring the execve() pair in the fork path.
+		 */
+		err = posix_spawn(&cmd->pid, argv.v[1], &fa, NULL,
+				  (char *const *) argv.v + 1,
+				  (char *const *) childenv);
+		if (err == ENOEXEC)
+			err = posix_spawn(&cmd->pid, argv.v[0], &fa, NULL,
+					  (char *const *) argv.v,
+					  (char *const *) childenv);
+
+		if (err) {
+			failed_errno = err;
+			errno = err;
+			cmd->pid = -1;
+			if (!cmd->silent_exec_failure || err != ENOENT)
+				error_errno("cannot spawn %s", cmd->args.v[0]);
+		} else if (cmd->clean_on_exit)
+			mark_child_for_cleanup(cmd->pid, cmd);
+
+		posix_spawn_file_actions_destroy(&fa);
+		free(childenv);
+	}
+
+	strvec_clear(&argv);
+}
+#elif !defined(GIT_WINDOWS_NATIVE)
 {
