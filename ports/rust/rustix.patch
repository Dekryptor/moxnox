+// Moxnox has no makedev and no device-number layout yet; use the
+// traditional encoding so these three stay consistent with each other.
+#[cfg(target_os = "moxnox")]
+#[inline]
+pub(crate) fn makedev(maj: u32, min: u32) -> Dev {
+    (Dev::from(maj) << 8) | Dev::from(min & 0xff)
+}
+
+#[cfg(target_os = "moxnox")]
+#[inline]
+pub(crate) fn major(dev: Dev) -> u32 {
+    ((dev >> 8) & 0xffff_ffff) as u32
+}
+
+#[cfg(target_os = "moxnox")]
+#[inline]
+pub(crate) fn minor(dev: Dev) -> u32 {
+    (dev & 0xff) as u32
+}
+
