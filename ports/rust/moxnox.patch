diff --git a/compiler/rustc_target/src/spec/targets/aarch64_pc_moxnox.rs b/compiler/rustc_target/src/spec/targets/aarch64_pc_moxnox.rs
new file mode 100644
index 00000000000..c6a831b4e21
--- /dev/null
+++ b/compiler/rustc_target/src/spec/targets/aarch64_pc_moxnox.rs
@@ -0,0 +1,28 @@
+use crate::spec::{Arch, FramePointer, Target, TargetMetadata, base};
+
+pub(crate) fn target() -> Target {
+    let mut base = base::moxnox::opts();
+    base.max_atomic_width = Some(128);
+    base.features = "+v8a,+neon".into();
+    base.linker = Some("aarch64-pc-moxnox-clang".into());
+
+    // The Windows ARM64 ABI, which moxnox follows, requires frame pointers
+    // for fast stack walking.
+    base.frame_pointer = FramePointer::NonLeaf;
+
+    Target {
+        llvm_target: "aarch64-pc-moxnox".into(),
+        metadata: TargetMetadata {
+            description: Some("ARM64 Moxnox".into()),
+            tier: Some(3),
+            host_tools: Some(false),
+            std: Some(true),
+        },
+        pointer_width: 64,
+        data_layout:
+            "e-m:w-p270:32:32-p271:32:32-p272:64:64-p:64:64-i32:32-i64:64-i128:128-n32:64-S128-Fn32"
+                .into(),
+        arch: Arch::AArch64,
+        options: base,
+    }
+}
diff --git a/compiler/rustc_target/src/spec/targets/x86_64_pc_moxnox.rs b/compiler/rustc_target/src/spec/targets/x86_64_pc_moxnox.rs
new file mode 100644
index 00000000000..e6ff53c2cca
--- /dev/null
+++ b/compiler/rustc_target/src/spec/targets/x86_64_pc_moxnox.rs
@@ -0,0 +1,26 @@
+use crate::spec::{Arch, Cc, LinkerFlavor, Lld, Target, TargetMetadata, base};
+
+pub(crate) fn target() -> Target {
+    let mut base = base::moxnox::opts();
+    base.cpu = "x86-64".into();
+    base.features = "+cmpxchg16b,+sse3,+lahfsahf".into();
+    base.plt_by_default = false;
+    base.add_pre_link_args(LinkerFlavor::Gnu(Cc::Yes, Lld::No), &["-m64"]);
+    base.max_atomic_width = Some(128);
+    base.linker = Some("x86_64-pc-moxnox-clang".into());
+
+    Target {
+        llvm_target: "x86_64-pc-moxnox".into(),
+        metadata: TargetMetadata {
+            description: Some("64-bit Moxnox".into()),
+            tier: Some(3),
+            host_tools: Some(false),
+            std: Some(true),
+        },
+        pointer_width: 64,
+        data_layout:
+            "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128".into(),
+        arch: Arch::X86_64,
+        options: base,
+    }
+}
