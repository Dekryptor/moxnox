+    use crate::arch::asm;
+    use crate::{io, slice};
+
+    // Minimal prefixes of the kernel's structures (modules/nt.cpp); only
+    // the fields up to the ones we read.
+    #[repr(C)]
+    struct UnicodeString {
+        length: u16,
+        maximum_length: u16,
+        buffer: *const u16,
+    }
+
+    #[repr(C)]
+    struct Curdir {
+        dos_path: UnicodeString,
+        handle: usize,
+    }
+
+    #[repr(C)]
+    struct ProcessParameters {
+        maximum_length: u32,
+        length: u32,
+        flags: u32,
+        debug_flags: u32,
+        console_handle: usize,
+        console_flags: u32,
+        standard_input: usize,
+        standard_output: usize,
+        standard_error: usize,
+        current_directory: Curdir,
+        dll_path: UnicodeString,
+        image_path_name: UnicodeString,
+    }
+
+    #[repr(C)]
+    struct Peb {
+        inherited_address_space: u8,
+        read_image_file_exec_options: u8,
+        being_debugged: u8,
+        bit_field: u8,
+        padding0: [u8; 4],
+        mutant: usize,
+        image_base_address: usize,
+        ldr: usize,
+        process_parameters: *const ProcessParameters,
+    }
+
+    #[repr(C)]
+    struct Teb {
+        nt_tib: [usize; 7],
+        environment_pointer: usize,
+        client_id: [usize; 2],
+        active_rpc_handle: usize,
+        thread_local_storage_pointer: usize,
+        process_environment_block: *const Peb,
+    }
+
+    unsafe fn teb() -> *const Teb {
+        let teb: *const Teb;
+        #[cfg(target_arch = "x86_64")]
+        unsafe {
+            // The gs base is the TEB; NtTib.Self at 0x30 points back to it.
+            asm!("mov {}, gs:[0x30]", out(reg) teb, options(nostack, preserves_flags));
+        }
+        #[cfg(target_arch = "aarch64")]
+        unsafe {
+            asm!("mov {}, x18", out(reg) teb, options(nomem, nostack, preserves_flags));
+        }
+        teb
+    }
+
+    unsafe {
+        let params = (*(*teb()).process_environment_block).process_parameters;
+        if params.is_null() {
+            return Err(io::const_error!(
+                io::ErrorKind::NotFound,
+                "an executable path was not found in the process parameters",
+            ));
+        }
+
+        let ips = &(*params).image_path_name;
+        if ips.buffer.is_null() || ips.length == 0 {
+            return Err(io::const_error!(
+                io::ErrorKind::NotFound,
+                "an executable path was not found in the process parameters",
+            ));
+        }
+
+        let units = slice::from_raw_parts(ips.buffer, usize::from(ips.length) / 2);
+        let s = String::from_utf16(units).map_err(|_| {
+            io::const_error!(io::ErrorKind::InvalidData, "the executable path is not valid UTF-16")
+        })?;
+
+        let path = PathBuf::from(s);
+        if path.is_absolute() { Ok(path) } else { getcwd().map(|cwd| cwd.join(path)) }
+    }
+}
