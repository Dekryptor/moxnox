new file mode 100644
index 00000000000..4d658b47226
--- /dev/null
+++ b/compiler/rustc_target/src/spec/base/moxnox.rs
@@ -0,0 +1,45 @@
+use std::borrow::Cow;
+
+use crate::spec::{
+    BinaryFormat, Cc, DebuginfoKind, LinkerFlavor, Lld, Os, SplitDebuginfo, TargetOptions, cvs,
+};
+
+pub(crate) fn opts() -> TargetOptions {
+    TargetOptions {
+        os: Os::Moxnox,
+        vendor: "pc".into(),
+        // The gcc runtime is linked statically everywhere on Moxnox; without
+        // this the driver's default -lgcc_s makes every dylib import
+        // libgcc_s_seh-1.dll.
+        pre_link_args: TargetOptions::link_args(
+            LinkerFlavor::Gnu(Cc::Yes, Lld::No),
+            &["-static-libgcc"],
+        ),
+        // FIXME(#13846) this should be enabled for moxnox
+        function_sections: false,
+        dynamic_linking: true,
+        dll_tls_export: false,
+        // Moxnox DLLs keep the lib prefix (libc++.dll etc.), unlike mingw.
+        dll_prefix: "lib".into(),
+        dll_suffix: ".dll".into(),
+        exe_suffix: ".exe".into(),
+        families: cvs!["unix"],
+        is_like_windows: true,
+        binary_format: BinaryFormat::Coff,
+        allows_weak_linkage: false,
+        // No late_link_args: the clang driver owns the CRT library ordering
+        // (the -lmoxnox/-lmingwex/-lmingw32/-lucrtbase_static sandwich).
+        abi_return_struct_as_int: true,
+        emit_debug_gdb_scripts: false,
+        requires_uwtable: true,
+        eh_frame_header: false,
+        no_default_libraries: false,
+        has_thread_local: true,
+        debuginfo_kind: DebuginfoKind::Dwarf,
+        // The platform's debugger and symbolization only speak DWARF 5,
+        // matching what clang emits; rustc's default is still 4.
+        default_dwarf_version: 5,
+        supported_split_debuginfo: Cow::Borrowed(&[SplitDebuginfo::Off]),
+        ..Default::default()
+    }
+}
