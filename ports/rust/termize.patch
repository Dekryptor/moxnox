 // Suppress warnings for `TIOCGWINSZ.into()` since freebsd requires it.
 #![allow(clippy::useless_conversion)]
 
-use libc::{STDERR_FILENO, STDIN_FILENO, STDOUT_FILENO, TIOCGWINSZ, ioctl, winsize};
+use libc::{STDERR_FILENO, STDIN_FILENO, STDOUT_FILENO, winsize};
+#[cfg(not(target_os = "moxnox"))]
+use libc::{TIOCGWINSZ, ioctl};
 use std::{fs::File, mem::zeroed, os::fd::AsRawFd};
 
+#[cfg(not(target_os = "moxnox"))]
+unsafe fn query(fd: libc::c_int, window: &mut winsize) -> libc::c_int {
+    unsafe { ioctl(fd, TIOCGWINSZ.into(), window) }
+}
+
+// Moxnox has no ioctl; tcgetwinsize is the POSIX 2024 equivalent
+#[cfg(target_os = "moxnox")]
+unsafe fn query(fd: libc::c_int, window: &mut winsize) -> libc::c_int {
+    unsafe { libc::tcgetwinsize(fd, window) }
+}
