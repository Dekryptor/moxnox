@@ -0,0 +1,1461 @@
+//! Definitions for Moxnox: PE/COFF and the Windows ABI, but a POSIX 2024
+//! userland (mnposix/ucrtbase). Transcribed from the platform's include/
+//! headers, which are the source of truth. Note LLP64: c_long is 32-bit.
+
+use crate::prelude::*;
+
+pub type wchar_t = u16;
+
+pub type off_t = c_longlong;
+pub type ino_t = u64;
+pub type dev_t = u32;
+pub type mode_t = u16;
+pub type pid_t = c_int;
+pub type time_t = c_longlong;
+pub type clock_t = c_long;
+pub type clockid_t = c_int;
+pub type uid_t = u32;
+pub type gid_t = u32;
+pub type id_t = u32;
+pub type useconds_t = c_uint;
+pub type suseconds_t = c_long;
+pub type blkcnt_t = u64;
+pub type blksize_t = u64;
+pub type fsblkcnt_t = u64;
+pub type fsfilcnt_t = u64;
+pub type nlink_t = u32;
+pub type rlim_t = c_uint;
+pub type sa_family_t = u16;
+pub type socklen_t = c_int;
+pub type in_addr_t = u32;
+pub type sigset_t = u64;
+pub type sighandler_t = size_t;
+pub type nfds_t = size_t;
+pub type wint_t = c_ushort;
+pub type wctype_t = c_ushort;
+pub type wctrans_t = wchar_t;
+pub type mbstate_t = c_int;
+pub type nl_item = c_int;
+pub type regoff_t = c_int;
+
+pub type pthread_t = uintptr_t;
+pub type pthread_key_t = size_t;
+pub type pthread_condattr_t = uintptr_t;
+pub type pthread_mutexattr_t = uintptr_t;
+pub type pthread_attr_t = uintptr_t;
+pub type pthread_once_t = uintptr_t;
+pub type pthread_rwlock_t = uintptr_t;
+pub type pthread_rwlockattr_t = uintptr_t;
+pub type pthread_barrier_t = uintptr_t;
+
+pub type posix_spawnattr_t = *mut c_void;
+
+pub type tcflag_t = c_uint;
+pub type cc_t = c_uchar;
+pub type speed_t = c_uint;
+
+s! {
+    pub struct pthread_mutex_t {
+        __x: [uintptr_t; 4],
+    }
+
+    pub struct pthread_cond_t {
+        __x: [uintptr_t; 2],
+    }
+
+    pub struct stat {
+        pub st_dev: dev_t,
+        pub st_ino: ino_t,
+        pub st_mode: mode_t,
+        pub st_nlink: nlink_t,
+        pub st_uid: uid_t,
+        pub st_gid: gid_t,
+        pub st_rdev: dev_t,
+        pub st_size: off_t,
+        pub st_atim: crate::timespec,
+        pub st_mtim: crate::timespec,
+        pub st_ctim: crate::timespec,
+        pub st_blksize: blksize_t,
+        pub st_blocks: blkcnt_t,
+    }
+
+    pub struct dirent {
+        pub d_ino: ino_t,
+        pub d_type: c_uchar,
+        pub d_name: [c_char; 260],
+    }
+
+    pub struct flock {
+        pub l_type: c_short,
+        pub l_whence: c_short,
+        pub l_start: off_t,
+        pub l_len: off_t,
+        pub l_pid: pid_t,
+    }
+
+    pub struct msghdr {
+        pub msg_name: *mut c_void,
+        pub msg_namelen: socklen_t,
+        pub msg_iov: *mut crate::iovec,
+        pub msg_iovlen: c_int,
+        pub msg_control: *mut c_void,
+        pub msg_controllen: socklen_t,
+        pub msg_flags: c_int,
+    }
+
+    pub struct sched_param {
+        pub sched_priority: c_int,
+    }
+
+    pub struct netent {
+        pub n_name: *mut c_char,
+        pub n_aliases: *mut *mut c_char,
+        pub n_addrtype: c_int,
+        pub n_net: u32,
+    }
+
+    pub struct glob_t {
+        pub gl_pathc: size_t,
+        pub gl_pathv: *mut *mut c_char,
+        pub gl_offs: size_t,
+    }
+
+    pub struct regex_t {
+        pub re_nsub: size_t,
+        pub value: *mut c_void,
+    }
+
+    pub struct regmatch_t {
+        pub rm_so: regoff_t,
+        pub rm_eo: regoff_t,
+    }
+
+    pub struct div_t {
+        pub quot: c_int,
+        pub rem: c_int,
+    }
+
+    pub struct ldiv_t {
+        pub quot: c_long,
+        pub rem: c_long,
+    }
+
+    pub struct lldiv_t {
+        pub quot: c_longlong,
+        pub rem: c_longlong,
+    }
+
+    pub struct tm {
+        pub tm_sec: c_int,
+        pub tm_min: c_int,
+        pub tm_hour: c_int,
+        pub tm_mday: c_int,
+        pub tm_mon: c_int,
+        pub tm_year: c_int,
+        pub tm_wday: c_int,
+        pub tm_yday: c_int,
+        pub tm_isdst: c_int,
+    }
+
+    pub struct siginfo_t {
+        pub si_signo: c_int,
+        pub si_errno: c_int,
+        pub si_code: c_int,
+        pub si_pid: pid_t,
+        pub si_uid: uid_t,
+        pub si_status: c_int,
+        pub si_value: crate::sigval,
+        pub si_addr: *mut c_void,
+        pub si_band: c_long,
+    }
+
+    pub struct sigaction {
+        pub sa_sigaction: sighandler_t,
+        pub sa_mask: sigset_t,
+        pub sa_flags: c_int,
+    }
+
+    // WSABUF shape: length first, unlike the POSIX ordering.
+    pub struct iovec {
+        pub iov_len: size_t,
+        pub iov_base: *mut c_void,
+    }
+
+    pub struct sockaddr {
+        pub sa_family: sa_family_t,
+        pub sa_data: [c_char; 14],
+    }
+
+    #[repr(align(8))]
+    pub struct sockaddr_storage {
+        pub ss_family: sa_family_t,
+        __ss_pad: [u8; 126],
+    }
+
+    pub struct sockaddr_in {
+        pub sin_family: sa_family_t,
+        pub sin_port: u16,
+        pub sin_addr: crate::in_addr,
+        pub sin_zero: [c_char; 8],
+    }
+
+    pub struct sockaddr_in6 {
+        pub sin6_family: sa_family_t,
+        pub sin6_port: u16,
+        pub sin6_flowinfo: u32,
+        pub sin6_addr: crate::in6_addr,
+        pub sin6_scope_id: u32,
+    }
+
+    pub struct sockaddr_un {
+        pub sun_family: sa_family_t,
+        pub sun_path: [c_char; 108],
+    }
+
+    pub struct in_addr {
+        pub s_addr: in_addr_t,
+    }
+
+    pub struct ip_mreq {
+        pub imr_multiaddr: in_addr,
+        pub imr_interface: in_addr,
+    }
+
+    pub struct addrinfo {
+        pub ai_flags: c_int,
+        pub ai_family: c_int,
+        pub ai_socktype: c_int,
+        pub ai_protocol: c_int,
+        pub ai_addrlen: size_t,
+        pub ai_canonname: *mut c_char,
+        pub ai_addr: *mut sockaddr,
+        pub ai_next: *mut addrinfo,
+    }
+
+    // win64 ordering: s_proto before s_port.
+    pub struct servent {
+        pub s_name: *mut c_char,
+        pub s_aliases: *mut *mut c_char,
+        pub s_proto: *mut c_char,
+        pub s_port: c_int,
+    }
+
+    pub struct passwd {
+        pub pw_name: *mut c_char,
+        pub pw_uid: uid_t,
+        pub pw_gid: gid_t,
+        pub pw_dir: *mut c_char,
+        pub pw_shell: *mut c_char,
+    }
+
+    pub struct group {
+        pub gr_name: *mut c_char,
+        pub gr_gid: gid_t,
+        pub gr_mem: *mut *mut c_char,
+    }
+
+    pub struct fd_set {
+        pub fds_bits: [c_ulong; FD_SETSIZE as usize / (8 * 4)],
+    }
+
+    pub struct sem_t {
+        __x: [usize; 2],
+    }
+
+    pub struct statvfs {
+        pub f_bsize: c_ulong,
+        pub f_frsize: c_ulong,
+        pub f_blocks: fsblkcnt_t,
+        pub f_bfree: fsblkcnt_t,
+        pub f_bavail: fsblkcnt_t,
+        pub f_files: fsfilcnt_t,
+        pub f_ffree: fsfilcnt_t,
+        pub f_favail: fsfilcnt_t,
+        pub f_fsid: c_ulong,
+        pub f_flag: c_ulong,
+        pub f_namemax: c_ulong,
+        pub f_basetype: [c_char; 16],
+    }
+
+    pub struct utsname {
+        pub sysname: [c_char; 65],
+        pub nodename: [c_char; 65],
+        pub release: [c_char; 65],
+        pub version: [c_char; 65],
+        pub machine: [c_char; 65],
+    }
+
+    pub struct posix_spawn_file_actions_t {
+        _ptr1: *mut c_void,
+        _ptr2: *mut c_void,
+    }
+
+    pub struct termios {
+        pub c_iflag: tcflag_t,
+        pub c_oflag: tcflag_t,
+        pub c_cflag: tcflag_t,
+        pub c_lflag: tcflag_t,
+        pub c_line: cc_t,
+        pub c_cc: [cc_t; NCCS],
+        pub c_ispeed: speed_t,
+        pub c_ospeed: speed_t,
+    }
+
+    // POSIX shape: row/col only.
+    pub struct winsize {
+        pub ws_row: c_ushort,
+        pub ws_col: c_ushort,
+    }
+
+    // UCRT ordering: int_curr_symbol and the int_* fields come last.
+    pub struct lconv {
+        pub decimal_point: *mut c_char,
+        pub thousands_sep: *mut c_char,
+        pub grouping: *mut c_char,
+        pub mon_decimal_point: *mut c_char,
+        pub mon_thousands_sep: *mut c_char,
+        pub mon_grouping: *mut c_char,
+        pub positive_sign: *mut c_char,
+        pub negative_sign: *mut c_char,
+        pub currency_symbol: *mut c_char,
+        pub frac_digits: c_char,
+        pub p_cs_precedes: c_char,
+        pub n_cs_precedes: c_char,
+        pub p_sep_by_space: c_char,
+        pub n_sep_by_space: c_char,
+        pub p_sign_posn: c_char,
+        pub n_sign_posn: c_char,
+        pub int_curr_symbol: *mut c_char,
+        pub int_frac_digits: c_char,
+        pub int_p_cs_precedes: c_char,
+        pub int_n_cs_precedes: c_char,
+        pub int_p_sep_by_space: c_char,
+        pub int_n_sep_by_space: c_char,
+        pub int_p_sign_posn: c_char,
+        pub int_n_sign_posn: c_char,
+    }
+}
+
+// errno.h (UCRT values)
+pub const EPERM: c_int = 1;
