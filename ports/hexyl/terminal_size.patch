+///
+/// Moxnox provides the POSIX.1-2024 tcgetwinsize directly.
+#[cfg(target_os = "moxnox")]
+pub fn terminal_size_of<Fd: AsFd>(fd: Fd) -> Option<(Width, Height)> {
+    use std::os::unix::io::AsRawFd;
+
+    let fd = fd.as_fd().as_raw_fd();
+    unsafe {
+        if libc::isatty(fd) == 0 {
+            return None;
+        }
+
+        let mut winsize = libc::winsize { ws_row: 0, ws_col: 0 };
+        if libc::tcgetwinsize(fd, &mut winsize) != 0 {
+            return None;
+        }
+
+        if winsize.ws_row > 0 && winsize.ws_col > 0 {
+            Some((Width(winsize.ws_col), Height(winsize.ws_row)))
+        } else {
+            None
+        }
+    }
+}
