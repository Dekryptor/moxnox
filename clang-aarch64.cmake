SET(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

SET(CMAKE_C_COMPILER clang)
SET(CMAKE_CXX_COMPILER clang++)
# SET(CMAKE_RC_COMPILER x86_64-w64-mingw32-windres)
# SET(CMAKE_ASM_COMPILER x86_64-w64-mingw32-gcc)
SET(DLLTOOL llvm-dlltool)
SET(AR llvm-ar)

SET(CLANG_TARGET_TRIPLE aarch64-w64-mingw32)
SET(CMAKE_C_COMPILER_TARGET aarch64-w64-mingw32)
SET(CMAKE_CXX_COMPILER_TARGET aarch64-w64-mingw32)
SET(CMAKE_ASM_COMPILER_TARGET aarch64-w64-mingw32)

set(CMAKE_EXE_LINKER_FLAGS "-static -nodefaultlibs")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-nodefaultlibs")
set(CMAKE_LINKER_TYPE LLD)

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)

set(CMAKE_USER_MAKE_RULES_OVERRIDE "${CMAKE_CURRENT_LIST_DIR}/toolchain.cmake" CACHE STRING "" FORCE)

set(CMAKE_ASM_FLAGS_INIT "${CMAKE_ASM_FLAGS_INIT} -I${CMAKE_SOURCE_DIR}/modules/aarch64")

set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

add_compile_options(-DMOXNOX)
