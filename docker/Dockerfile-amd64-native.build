FROM gentoo/stage3:latest

RUN emerge --sync
RUN mkdir -p /etc/portage/patches/sys-devel/crossdev && cd /etc/portage/patches/sys-devel/crossdev && wget https://moxnox.dev/crossdev-moxnox.patch https://moxnox.dev/crossdev-moxnox-clang-cfg.patch
RUN mkdir -p /etc/portage/patches/cross-x86_64-pc-moxnox/binutils && cd /etc/portage/patches/cross-x86_64-pc-moxnox/binutils && wget https://moxnox.dev/binutils-moxnox.patch
RUN mkdir -p /etc/portage/patches/cross-x86_64-pc-moxnox/gcc && cd /etc/portage/patches/cross-x86_64-pc-moxnox/gcc && wget https://moxnox.dev/gcc-moxnox.tar.gz && tar -xzf gcc-moxnox.tar.gz && rm gcc-moxnox.tar.gz
RUN mkdir -p /etc/portage/patches/sys-devel/gnuconfig && cd /etc/portage/patches/sys-devel/gnuconfig && wget https://moxnox.dev/gnuconfig-moxnox.patch
RUN mkdir -p /etc/portage/patches/dev-build/cmake && cd /etc/portage/patches/dev-build/cmake && wget https://moxnox.dev/cmake-moxnox.patch
RUN emerge app-eselect/eselect-repository sys-devel/crossdev sys-devel/gnuconfig dev-vcs/git dev-build/cmake
RUN eselect repository create crossdev
RUN printf '[moxnox]\nlocation = /var/db/repos/moxnox\nsync-type = git\nsync-uri = https://git.burntcomma.com/moxnox/portage\nauto-sync = yes\n' > /etc/portage/repos.conf/moxnox.conf
RUN emerge --sync moxnox
RUN sed -i 's|masters = gentoo|masters = gentoo moxnox|g' /var/db/repos/crossdev/metadata/layout.conf
RUN echo ACCEPT_LICENSE="\"*\"" >> /etc/portage/make.conf
RUN echo "cross-x86_64-pc-moxnox/gcc -openmp -fortran" >> /etc/portage/package.use/moxnox
RUN crossdev -t x86_64-pc-moxnox
RUN echo "dev-build/moxnox-cmake-platform" >> /etc/portage/package.accept_keywords/moxnox
RUN emerge dev-build/moxnox-cmake-platform
RUN echo "sys-devel/binutils multitarget" >> /etc/portage/package.use/moxnox
RUN emerge sys-devel/binutils

RUN emerge net-misc/s3cmd
RUN emerge app-arch/cpio app-misc/jq dev-util/xxd net-libs/nodejs

RUN mkdir -p /etc/portage/patches/llvm-core/llvm && cd /etc/portage/patches/llvm-core/llvm && wget https://moxnox.dev/llvm-moxnox.tar.gz && tar -xzf llvm-moxnox.tar.gz && rm llvm-moxnox.tar.gz
RUN mkdir -p /etc/portage/patches/llvm-core/clang && cd /etc/portage/patches/llvm-core/clang && wget https://moxnox.dev/clang-moxnox.tar.gz && tar -xzf clang-moxnox.tar.gz && rm clang-moxnox.tar.gz
RUN mkdir -p /etc/portage/patches/dev-lang/rust && cd /etc/portage/patches/dev-lang/rust && wget https://moxnox.dev/rust-moxnox.tar.gz && tar -xzf rust-moxnox.tar.gz && rm rust-moxnox.tar.gz
RUN mkdir -p /etc/portage/env/dev-lang && printf "I_KNOW_WHAT_I_AM_DOING_CROSS=1\nRUST_CROSS_TARGETS=(\n\tX86:x86_64-pc-moxnox:x86_64-pc-moxnox\n)\n" > /etc/portage/env/dev-lang/rust
RUN echo "dev-lang/rust::moxnox **" >> /etc/portage/package.accept_keywords/moxnox
RUN emerge llvm-core/clang
RUN mkdir -p /var/db/repos/crossdev/cross_llvm-x86_64-pc-moxnox && ln -s /var/db/repos/gentoo/sys-devel/clang-crossdev-wrappers /var/db/repos/crossdev/cross_llvm-x86_64-pc-moxnox/clang-crossdev-wrappers
RUN echo "cross_llvm-x86_64-pc-moxnox/clang-crossdev-wrappers:22 **" >> /etc/portage/package.accept_keywords/moxnox
RUN echo cross_llvm-x86_64-pc-moxnox >> /var/db/repos/crossdev/profiles/categories
RUN emerge cross_llvm-x86_64-pc-moxnox/clang-crossdev-wrappers:22
RUN mkdir -p /etc/clang/cross && printf -- "--sysroot=/usr/x86_64-pc-moxnox\n--target=x86_64-pc-moxnox\n@../gentoo-runtimes.cfg\n" > /etc/clang/cross/x86_64-pc-moxnox.cfg
RUN emerge =dev-lang/rust-1.95.0

RUN printf 'if [[ ${CATEGORY}/${PN} == llvm-core/llvm ]]; then\n\tcheck_distribution_components() { :; }\n\tmultilib_prepare_wrappers() { :; }\n\tmultilib_install_wrappers() { :; }\nfi\n' >> /usr/x86_64-pc-moxnox/etc/portage/bashrc
RUN printf 'USE_EXPAND_VALUES_KERNEL="Darwin Hurd linux SunOS Winnt Moxnox"\nUSE_EXPAND_VALUES_ELIBC="bionic Darwin glibc mingw musl SunOS moxnox"\n' >> /usr/x86_64-pc-moxnox/etc/portage/profile/make.defaults
RUN echo LLVM_TARGETS="\"X86\"" >> /usr/x86_64-pc-moxnox/etc/portage/make.conf
RUN mkdir -p /usr/x86_64-pc-moxnox/etc/portage/package.accept_keywords && printf 'llvm-core/llvm:22 ~amd64\n' >> /usr/x86_64-pc-moxnox/etc/portage/package.accept_keywords/llvm
RUN mkdir -p /usr/x86_64-pc-moxnox/etc/portage/package.use && printf 'llvm-core/llvm -binutils-plugin -libffi\n' >> /usr/x86_64-pc-moxnox/etc/portage/package.use/llvm
RUN mkdir -p /usr/x86_64-pc-moxnox/etc/portage/package.env && printf 'llvm-core/llvm moxnox-llvm\n' >> /usr/x86_64-pc-moxnox/etc/portage/package.env/llvm
RUN mkdir -p /usr/x86_64-pc-moxnox/etc/portage/env && printf 'MYCMAKEARGS="${MYCMAKEARGS} -DLLVM_BUILD_LLVM_DYLIB=OFF -DLLVM_LINK_LLVM_DYLIB=OFF -DLLVM_ENABLE_ZLIB=OFF -DCMAKE_BUILD_TYPE=Release -DHAVE_LIBPTHREAD=0 -DHAVE_LIBRT=0 -DHAVE_LIBDL=0 -DLLVM_DISTRIBUTION_COMPONENTS=\\\"llvm-libraries;llvm-headers;cmake-exports;llvm-config\\\""\nFEATURES=\"${FEATURES} nostrip\"\n' >> /usr/x86_64-pc-moxnox/etc/portage/env/moxnox-llvm
RUN mkdir -p /usr/x86_64-pc-moxnox/etc/portage/patches/llvm-core/llvm && cd /usr/x86_64-pc-moxnox/etc/portage/patches/llvm-core/llvm && wget https://moxnox.dev/llvm-moxnox.tar.gz && tar -xzf llvm-moxnox.tar.gz && rm llvm-moxnox.tar.gz
RUN emerge dev-python/mako dev-python/pyaml
RUN x86_64-pc-moxnox-emerge --nodeps llvm-core/llvm:22 # --nodeps because Gentoo pulls in zlib despite the fact we've disabled it

RUN printf 'llvm-core/clang-linker-config default-lld\n' >> /usr/x86_64-pc-moxnox/etc/portage/package.use/moxnox
RUN printf 'llvm-core/clang-common default-compiler-rt default-libcxx default-lld llvm-libunwind\n' >> /usr/x86_64-pc-moxnox/etc/portage/package.use/moxnox
RUN printf 'llvm-runtimes/libunwind static-libs\n' >> /usr/x86_64-pc-moxnox/etc/portage/package.use/moxnox
RUN printf 'llvm-runtimes/clang-runtime default-libcxx default-compiler-rt llvm-libunwind default-lld\n' >> /usr/x86_64-pc-moxnox/etc/portage/package.use/moxnox
RUN printf 'llvm-runtimes/clang-rtlib-config default-compiler-rt\n' >> /usr/x86_64-pc-moxnox/etc/portage/package.use/moxnox
RUN printf 'llvm-runtimes/clang-unwindlib-config default-compiler-rt llvm-libunwind\n' >> /usr/x86_64-pc-moxnox/etc/portage/package.use/moxnox
RUN printf 'llvm-runtimes/clang-stdlib-config default-libcxx\n' >> /usr/x86_64-pc-moxnox/etc/portage/package.use/moxnox

RUN mkdir -p /usr/x86_64-pc-moxnox/etc/portage/patches/llvm-runtimes/compiler-rt && cd /usr/x86_64-pc-moxnox/etc/portage/patches/llvm-runtimes/compiler-rt && wget https://moxnox.dev/compiler-rt-moxnox.patch
RUN mkdir -p /etc/portage/patches/cross-x86_64-pc-moxnox/compiler-rt && cp /usr/x86_64-pc-moxnox/etc/portage/patches/llvm-runtimes/compiler-rt/*.patch /etc/portage/patches/cross-x86_64-pc-moxnox/compiler-rt/
RUN x86_64-pc-moxnox-emerge --nodeps llvm-core/clang-linker-config:22
RUN mkdir -p /var/db/repos/crossdev/cross-x86_64-pc-moxnox && ln -s /var/db/repos/gentoo/llvm-runtimes/compiler-rt /var/db/repos/crossdev/cross-x86_64-pc-moxnox/compiler-rt
RUN mkdir -p /etc/portage/package.env && printf 'cross-x86_64-pc-moxnox/compiler-rt moxnox-compiler-rt.conf\n' >> /etc/portage/package.env/moxnox
RUN mkdir -p /etc/portage/env && printf 'MYCMAKEARGS="${MYCMAKEARGS} -DCMAKE_TOOLCHAIN_FILE=/etc/moxnox-amd64-toolchain.cmake -DCOMPILER_RT_BUILD_CRT=OFF"\nFEATURES=\"${FEATURES} nostrip\"\n' >> /etc/portage/env/moxnox-compiler-rt.conf
RUN printf "set(CMAKE_SYSTEM_NAME Moxnox)\nset(CMAKE_SYSTEM_PROCESSOR amd64)\nset(CMAKE_SYSROOT /usr/x86_64-pc-moxnox)\nset(CMAKE_C_COMPILER x86_64-pc-moxnox-clang)\nset(CMAKE_CXX_COMPILER x86_64-pc-moxnox-clang++)\nset(CMAKE_ASM_COMPILER x86_64-pc-moxnox-clang)\nset(CMAKE_AR llvm-ar CACHE FILEPATH \"\" FORCE)\nset(CMAKE_RANLIB llvm-ranlib CACHE FILEPATH \"\" FORCE)\nset(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)\nset(LIBUNWIND_HAS_C_LIB OFF CACHE BOOL \"\")\nset(LIBUNWIND_HAS_PTHREAD_LIB OFF CACHE BOOL \"\")\nset(LIBCXXABI_HAS_C_LIB OFF CACHE BOOL \"\")\nset(LIBCXXABI_HAS_PTHREAD_LIB OFF CACHE BOOL \"\")\nset(LIBCXX_HAS_PTHREAD_LIB OFF CACHE BOOL \"\")\nset(LIBCXX_HAS_ATOMIC_LIB OFF CACHE BOOL \"\")\nset(LIBCXX_HAS_RT_LIB OFF CACHE BOOL \"\")\n" > /etc/moxnox-amd64-toolchain.cmake
RUN emerge cross-x86_64-pc-moxnox/compiler-rt
RUN x86_64-pc-moxnox-emerge --nodeps llvm-runtimes/clang-rtlib-config:22

RUN printf 'llvm-runtimes/libunwind moxnox-libunwind.conf\n' >> /usr/x86_64-pc-moxnox/etc/portage/package.env/moxnox
RUN printf 'MYCMAKEARGS="${MYCMAKEARGS} -DCMAKE_TOOLCHAIN_FILE=/etc/moxnox-amd64-toolchain.cmake -DLIBUNWIND_ENABLE_SHARED=OFF -DLIBUNWIND_HIDE_SYMBOLS=ON -DLIBUNWIND_INSTALL_HEADERS=OFF"\nCC=x86_64-pc-moxnox-clang\nCXX=x86_64-pc-moxnox-clang++\nCFLAGS=\"${CFLAGS} -D_WIN32 -D_WIN64 -D__MINGW32__ -D__MINGW64__ -D__MSVCRT__ -D__STRALIGN_H_ -idirafter/usr/x86_64-pc-moxnox/mingw-compat/include\"\nCXXFLAGS=\"${CXXFLAGS} -D_WIN32 -D_WIN64 -D__MINGW32__ -D__MINGW64__ -D__MSVCRT__ -D__STRALIGN_H_ -idirafter/usr/x86_64-pc-moxnox/mingw-compat/include\"\nLIBDIR_amd64=\"lib\"\nFEATURES=\"${FEATURES} nostrip\"\n' >> /usr/x86_64-pc-moxnox/etc/portage/env/moxnox-libunwind.conf
RUN x86_64-pc-moxnox-emerge llvm-runtimes/libunwind llvm-runtimes/clang-unwindlib-config:22

RUN mkdir -p /usr/x86_64-pc-moxnox/etc/portage/patches/llvm-runtimes/libcxx && cd /usr/x86_64-pc-moxnox/etc/portage/patches/llvm-runtimes/libcxx && wget https://moxnox.dev/libcxx-moxnox.tar.gz && tar -xzf libcxx-moxnox.tar.gz && rm libcxx-moxnox.tar.gz
RUN mkdir -p /usr/x86_64-pc-moxnox/etc/portage/patches/llvm-runtimes/libcxxabi && cp /usr/x86_64-pc-moxnox/etc/portage/patches/llvm-runtimes/libcxx/*.patch /usr/x86_64-pc-moxnox/etc/portage/patches/llvm-runtimes/libcxxabi/
RUN printf 'llvm-runtimes/libcxxabi moxnox-libcxxabi.conf\n' >> /usr/x86_64-pc-moxnox/etc/portage/package.env/moxnox
RUN printf "MYCMAKEARGS=\"\${MYCMAKEARGS} -DCMAKE_TOOLCHAIN_FILE=/etc/moxnox-amd64-toolchain.cmake -DLIBCXXABI_HERMETIC_STATIC_LIBRARY=ON -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON\"\nLDFLAGS=\"\${LDFLAGS} -nostdlib++\"\nCC=x86_64-pc-moxnox-clang\nCXX=x86_64-pc-moxnox-clang++\nLIBDIR_amd64=\"lib\"\nFEATURES=\"\${FEATURES} nostrip\"\n" > /usr/x86_64-pc-moxnox/etc/portage/env/moxnox-libcxxabi.conf
RUN x86_64-pc-moxnox-emerge llvm-runtimes/libcxxabi

RUN mkdir -p /usr/x86_64-pc-moxnox/etc/portage/repos.conf && ln -s /etc/portage/repos.conf/moxnox.conf /usr/x86_64-pc-moxnox/etc/portage/repos.conf/moxnox.conf
RUN printf 'llvm-runtimes/libcxx moxnox-libcxx.conf\n' >> /usr/x86_64-pc-moxnox/etc/portage/package.env/moxnox
RUN printf "MYCMAKEARGS=\"\${MYCMAKEARGS} -DCMAKE_TOOLCHAIN_FILE=/etc/moxnox-amd64-toolchain.cmake -DLIBCXX_HERMETIC_STATIC_LIBRARY=ON -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON\"\nLDFLAGS=\"\${LDFLAGS} -nostdlib++\"\nCC=x86_64-pc-moxnox-clang\nCXX=x86_64-pc-moxnox-clang++\nLIBDIR_amd64=\"lib\"\nFEATURES=\"\${FEATURES} nostrip\"\n" > /usr/x86_64-pc-moxnox/etc/portage/env/moxnox-libcxx.conf
RUN x86_64-pc-moxnox-emerge llvm-runtimes/libcxx

RUN echo "ac_cv_c_bigendian=no" >> /usr/x86_64-pc-moxnox/etc/portage/config.site
RUN echo "CONFIG_SITE=\"/usr/x86_64-pc-moxnox/etc/portage/config.site\"" >> /usr/x86_64-pc-moxnox/etc/portage/make.conf

RUN rm -rf /var/cache/distfiles
RUN env-update

ENV PATH="/usr/lib/llvm/22/bin:${PATH}"
