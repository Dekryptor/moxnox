FROM ubuntu:rolling
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y \
    git cmake ninja-build ca-certificates \
    clang clang-tools libc++-dev llvm lld \
    wget xz-utils make texinfo bison flex \
    nodejs cpio s3cmd llvm mingw-w64-common \
    jq xxd curl \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --branch binutils-2_46-branch --depth 1 https://git.burntcomma.com/maharmstone/binutils-gdb &&\
    cd binutils-gdb &&\
    ./configure --prefix=/usr --build=x86_64-linux-gnu --host=x86_64-linux-gnu --target=x86_64-linux-gnu --mandir=/usr/share/man --infodir=/usr/share/info --datadir=/usr/share --sysconfdir=/etc --localstatedir=/var/lib --datarootdir=/usr/share --docdir=/usr/share/doc/binutils-2.46.0 --htmldir=/usr/share/doc/binutils-2.46.0/html --enable-plugins --without-included-gettext --without-zlib --with-sysroot=/usr/x86_64-linux-gnu --enable-poison-system-directories --enable-secureplt --enable-default-hash-style=gnu --infodir=/usr/share/binutils-data/x86_64-linux-gnu/2.46.0/info --mandir=/usr/share/binutils-data/x86_64-linux-gnu/2.46.0/man --bindir=/usr/bin --libdir=/usr/lib64/binutils/x86_64-linux-gnu/2.46.0 --libexecdir=/usr/lib64/binutils/x86_64-linux-gnu/2.46.0 --includedir=/usr/lib64/binutils/x86_64-linux-gnu/2.46.0/include --disable-dependency-tracking --disable-silent-rules --enable-obsolete --enable-shared --enable-threads --enable-relro --disable-install-libiberty --enable-textrel-check=warning --enable-new-dtags --disable-jansson --disable-werror --disable-static --without-xxhash --without-zstd --disable-gdb --disable-gdbserver --disable-libbacktrace --disable-libdecnumber --disable-readline --disable-sim --without-stage1-ldflags --without-debuginfod --without-msgpack --disable-cet --disable-gprofng --enable-colored-disassembly --enable-warn-execstack=yes --enable-warn-rwx-segments=yes --enable-targets=all &&\
    make -j$(nproc) &&\
    make install
RUN cd /root &&\
    wget https://github.com/mstorsjo/llvm-mingw/releases/download/20250402/llvm-mingw-20250402-ucrt-ubuntu-20.04-x86_64.tar.xz &&\
    tar -xf llvm-mingw-20250402-ucrt-ubuntu-20.04-x86_64.tar.xz &&\
    rm llvm-mingw-20250402-ucrt-ubuntu-20.04-x86_64.tar.xz &&\
    mv llvm-mingw-20250402-ucrt-ubuntu-20.04-x86_64 llvm-mingw
WORKDIR /workspace
